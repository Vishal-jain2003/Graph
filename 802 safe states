any node that is part of cycle is not the safe node 
any one leads to cycle can't safe


  

class Solution {
    public List<Integer> eventualSafeNodes(int[][] graph) {
        int v = graph.length;
        boolean[] vis = new boolean[v];
        boolean[] stackarray=new boolean[v];
        for (int i=0;i<v;i++)
        {
            dfs(i,graph,vis,stackarray);
        }
        List<Integer>safe = new ArrayList<>();
        for (int i=0;i<v;i++)
        {
            if (!stackarray[i])
            {
                safe.add(i);
            }
        }
        return safe;
    }
    boolean dfs(int node,int[][] adj,boolean[] vis,boolean[] stack)
    {
        if (stack[node]) return true; // cycle

        if (vis[node]) return false;

        vis[node]=true;
        stack[node]=true;
        for (int neighbour:adj[node])
        {
            if (dfs(neighbour,adj,vis,stack)) return true;
        }
        stack[node]=false;
        return false;
    }

}
